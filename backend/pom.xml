<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- Spring Boot 官方父工程：统一管理依赖版本 -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.2.5</version>
        <relativePath/>
    </parent>

    <groupId>com.campus</groupId>
    <artifactId>campus-trade-backend</artifactId>
    <version>0.0.3</version>
    <name>campus-trade-backend</name>
    <description>校园二手交易平台 - 后端服务（Spring Boot 3 + MyBatis-Plus + MySQL）</description>

    <properties>
        <java.version>17</java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <mybatis-plus.version>3.5.7</mybatis-plus.version>
        <jjwt.version>0.12.5</jjwt.version>
    </properties>

    <dependencies>
        <!-- Redis（v0.12）：缓存、计数器、限流、热门榜、Token 黑名单，客户端用默认的 Lettuce -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis</artifactId>
        </dependency>
        <!-- Lettuce 连接池（使用 spring.data.redis.lettuce.pool.* 配置时必须引入） -->
        <dependency>
            <groupId>org.apache.commons</groupId>
            <artifactId>commons-pool2</artifactId>
        </dependency>
        <!-- AOP：注解式限流 @RateLimit 的切面实现 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-aop</artifactId>
        </dependency>

        <!-- Web：REST 接口 + 内嵌 Tomcat -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- WebSocket：v0.14 实时私信（底层用 Tomcat 的 WebSocket 实现，无需额外容器） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-websocket</artifactId>
        </dependency>

        <!-- 参数校验：@Valid / @NotBlank 等 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- MyBatis-Plus（Spring Boot 3 专用 starter） -->
        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus-spring-boot3-starter</artifactId>
            <version>${mybatis-plus.version}</version>
        </dependency>

        <!-- MySQL 驱动（版本由 Spring Boot 统一管理） -->
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- Lombok：@Data / @Slf4j，编译期生效 -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- ================= v0.04 用户模块新增依赖 ================= -->
        <!-- 密码加密：BCryptPasswordEncoder（只引入加密模块，不引入完整的 Spring Security 过滤器链） -->
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-crypto</artifactId>
        </dependency>

        <!-- JWT：jjwt-api 编译期使用，impl/jackson 运行期加载 -->
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-api</artifactId>
            <version>${jjwt.version}</version>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-impl</artifactId>
            <version>${jjwt.version}</version>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-jackson</artifactId>
            <version>${jjwt.version}</version>
            <scope>runtime</scope>
        </dependency>
        <!-- ======================================================== -->

        <!-- 运维监控（v0.17）：Actuator —— 暴露 JVM/HTTP/缓存等运行指标。
             安全边界见 application.yml：只暴露 health/info/metrics，
             且仅绑定 127.0.0.1:8090（局域网与外网均不可达）。 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <!-- v0.18：接口文档（OpenAPI 3 / Swagger UI）。2.x 版本线对应 Spring Boot 3.2.x。
             说明：登录拦截器只作用于 /api/**，因此 /v3/api-docs 与 /swagger-ui/** 无需额外放行；
             若生产环境不希望暴露接口文档，可在 application-prod.yml 设
             springdoc.api-docs.enabled=false 与 springdoc.swagger-ui.enabled=false。 -->
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
            <version>2.3.0</version>
        </dependency>

        <!-- 测试 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <excludes>
                        <exclude>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </exclude>
                    </excludes>
                </configuration>
            </plugin>

            <!-- ============================================================
                 测试覆盖率（v0.17 引入）
                 用途：让"测试做得怎么样"从感觉变成数字 —— 测试方向毕设的核心指标。
                 执行：./mvnw test         → 自动生成 target/site/jacoco/index.html
                       ./mvnw test jacoco:report
                 说明：覆盖率阈值采用"只许上升"的棘轮策略（见 CI），
                       当前基线见 docs/测试覆盖率说明.md，清理完一个模块就上调一次。
                 ============================================================ -->
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>0.8.11</version>
                <configuration>
                    <!-- 只度量"逻辑代码"：实体/DTO/VO/配置与启动类不计入分母。
                         否则大量 getter/setter 与常量类会稀释真实覆盖率，指标就失去意义。 -->
                    <excludes>
                        <exclude>**/entity/**</exclude>
                        <exclude>**/dto/**</exclude>
                        <exclude>**/vo/**</exclude>
                        <exclude>**/config/**</exclude>
                        <exclude>**/*Application.class</exclude>
                    </excludes>
                </configuration>
                <executions>
                    <execution>
                        <id>prepare-agent</id>
                        <goals>
                            <goal>prepare-agent</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>report</id>
                        <phase>test</phase>
                        <goals>
                            <goal>report</goal>
                        </goals>
                    </execution>
                    <!-- 覆盖率棘轮：与设计令牌/状态检查同一策略 —— 只许上升，不许回退。
                         基线记录见 docs/测试覆盖率说明.md：
                           2026-10-09  3.38%（引入 JaCoCo，当时仅内容机审 1 个测试类）
                           2026-10-15  8.23%（补「错误码枚举不变量」+「业务异常体系」）
                           2026-10-15 10.12%（补「缓存键规范」+「统一响应」+「分页结果」）
                           2026-10-15 13.37%（补「限流切面」+「全局异常处理器」+「缓存失效入口」）
                           2026-10-15 19.02%（补「订单状态机」：下单/取消/完成/防一物多卖/越权/信用分）
                           2026-10-15 20.46%（补「WebSocket 会话注册表」：多端在线/定向推送/坏连接隔离/并发）
                           2026-10-15 20.51%（安全测试 C2 发现异常处理缺口 → 补「请求体类型不支持」分支 + 单测）
                           2026-10-15 21.20%（C3 机审落库：ModerationLogService 独立事务落库 + 6 条单测）
                           2026-10-16 26.69%（收尾⑥ 商品模块单测：发布机审三态、缓存纪律、防击穿降级链 36 条）
                           2026-10-16 29.22%（收尾⑦ 缓存服务实现：总开关降级、TTL 抖动、分布式锁、热门榜 27 条）
                           2026-10-16 34.34%（收尾⑦ WebSocket：握手鉴权状态码语义 + 信封协议分发与坏消息不断连 31 条）
                           2026-10-16 36.54%（收尾⑨-3 登录拦截器 + 商品接口层：注解决定鉴权、可选鉴权、统一响应契约 34 条）
                           2026-10-16 37.25%（第2批⑤ 图片内容识别：magic number 校验 22 条，含 HTML/PHP/EXE/ZIP 伪装与扩展名不一致）
                           2026-10-16 39.98%（第3批⑩ 补 JWT/黑名单/WS 信封与入站解析/统一响应/异常契约 68 条）
                           2026-10-16 41.55%（★ 口径调整：lombok.config 排除 Lombok 生成方法，只统计手写逻辑；并修掉 PageResult 记录为 null 的缺陷）
                           2026-10-16 45.21%（第3批⑪ 接口层补测：8 个测试类覆盖全部 16 个控制器，controller 包 15.49% → 88.48%）
                         阈值取 44%（略低于实测 45.21%）→ 给日常小改动留余量；
                         每补完一块测试就把这里的 minimum 上调一次。 -->
                    <execution>
                        <id>check-ratchet</id>
                        <phase>test</phase>
                        <goals>
                            <goal>check</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <rule>
                                    <element>BUNDLE</element>
                                    <limits>
                                        <limit>
                                            <counter>INSTRUCTION</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>0.44</minimum>
                                        </limit>
                                    </limits>
                                </rule>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
