{
  "name": "campus-trade-frontend",
  "version": "0.16.0",
  "private": true,
  "description": "校园二手交易平台 - 前端（Vue3 + Vite + Element Plus）",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview --port 4173",
    "test:unit": "node ../tests/unit/catalogue.test.mjs && node ../tests/unit/product-rules.test.mjs",
    "test:coverage": "c8 --reporter=text node ../tests/unit/catalogue.test.mjs && c8 --clean=false --reporter=text node ../tests/unit/product-rules.test.mjs",
    "test:component": "vitest run",
    "test:component:coverage": "vitest run --coverage",
    "test:all": "node ../tests/unit/catalogue.test.mjs && node ../tests/unit/product-rules.test.mjs && vitest run"
  },
  "dependencies": {
    "axios": "^1.7.2",
    "echarts": "^6.1.0",
    "element-plus": "^2.7.5",
    "pinia": "^2.1.7",
    "vue": "^3.4.27",
    "vue-router": "^4.3.2"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.0.4",
    "@vitest/coverage-v8": "3.2.6",
    "@vue/test-utils": "2.4.6",
    "c8": "^12.0.0",
    "jsdom": "24.1.0",
    "vite": "^6.4.3",
    "vitest": "3.2.6"
  }
}
