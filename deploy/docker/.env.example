# =============================================================================
# 校园二手交易平台 · 生产环境变量模板（v0.15）
#
# 用法：
#   cp deploy/docker/.env.example deploy/docker/.env
#   然后修改下面的密码与密钥（.env 已被 .gitignore 忽略，不会提交到仓库）
#   docker compose --env-file deploy/docker/.env -f deploy/docker/docker-compose.yml up -d
# =============================================================================

# ---------------------------- MySQL ----------------------------
MYSQL_ROOT_PASSWORD=ChangeMe_Root_2026
MYSQL_DB=campus_trade
MYSQL_USER=campus
MYSQL_PASSWORD=ChangeMe_Campus_2026

# ---------------------------- Redis ----------------------------
# 内网可留空；公网部署必须设置密码，并在 redis 服务启动参数里加上 --requirepass
REDIS_PASSWORD=

# ---------------------------- 应用密钥 ----------------------------
# JWT 签名密钥：必须注入，长度 ≥ 32 字节（不足会启动失败）
# 生成方式（任选）：
#   PowerShell:  -join ((1..48) | %{ '{0:x}' -f (Get-Random -Max 16) })
#   Linux:       openssl rand -hex 24
JWT_SECRET=please_replace_with_a_random_string_at_least_32_bytes_long

# ---------------------------- 对外访问 ----------------------------
# 前端对外端口（默认 80，若被占用可改成 8081 等）
WEB_PORT=80

# 允许跨域的前端来源（多个用逗号分隔；生产填正式域名）
CORS_ORIGINS=http://localhost

# ---------------------------- 业务开关 ----------------------------
# 是否开启"先审后发"（生产建议 true）
AUDIT_ENABLED=true
# 是否开启 Redis 缓存（生产建议 true）
CACHE_ENABLED=true
# 是否开放数据库详情探针（生产必须 false，避免暴露库表统计）
HEALTH_DETAIL_ENABLED=false
